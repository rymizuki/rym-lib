    "directory": "packages/query-module-driver-prisma"
  },
  "license": "MIT",
  "description": "",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build/*"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint . && tsc --noEmit && prettier --check \"src/**/*.{ts,js,json}\"",
    "format": "prettier -w './**/*.{ts,tsx,js,json,css}' --check",
    "ncu": "npm-check-updates"
  },
  "dependencies": {
    "@rym-lib/query-module-sql-builder": "2.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@rym-lib/dev-config": "*",
    "@rym-lib/query-module": "2.1.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "npm-check-updates": "^17.0.6",
    "prisma": "^5.22.0",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0",
    "vitest-mock-extended": "^5.1.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  }
}
